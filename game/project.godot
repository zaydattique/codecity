config_version=5

[application]
config/name="CodeCity: Living World"
run/main_scene="res://scenes/foundation.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]
WorldClock="*res://core/world_clock.gd"
EventBus="*res://core/event_bus.gd"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"

[input]

move_forward={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":87)]
}

move_back={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":83)]
}

move_left={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":65)]
}

move_right={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":68)]
}

interact={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":69)]
}

jump={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":32)]
}

sprint={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":4194325)]
}

crouch={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":67)]
}

phone={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":80)]
}

vehicle_brake={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":32)]
}

pause_game={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":4194305)]
}

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
