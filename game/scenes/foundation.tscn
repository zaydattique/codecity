autowrap_mode = 2

[node name="Exit" type="Button" parent="CanvasLayer/Center/VBox"]
text = "Exit"

[connection signal="pressed" from="CanvasLayer/Center/VBox/Apply" to="." method="_on_apply_pressed"]
[connection signal="pressed" from="CanvasLayer/Center/VBox/Exit" to="." method="_on_exit_pressed"]
