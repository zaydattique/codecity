[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scenes/foundation.gd" id="1"]

[node name="Foundation" type="Node3D"]
script = ExtResource("1")

[node name="Camera3D" type="Camera3D" parent="."]
current = true

[node name="CanvasLayer" type="CanvasLayer" parent="."]

[node name="Background" type="ColorRect" parent="CanvasLayer"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
mouse_filter = 2
color = Color(0.045, 0.055, 0.065, 1)

[node name="Center" type="CenterContainer" parent="CanvasLayer"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0

[node name="VBox" type="VBoxContainer" parent="CanvasLayer/Center"]
custom_minimum_size = Vector2(540, 0)
theme_override_constants/separation = 12

[node name="Title" type="Label" parent="CanvasLayer/Center/VBox"]
theme_override_font_sizes/font_size = 56
text = "CODECITY"
horizontal_alignment = 1

[node name="Subtitle" type="Label" parent="CanvasLayer/Center/VBox"]
text = "HARBOR BOULEVARD  /  CHOOSE YOUR WORLD"
horizontal_alignment = 1

[node name="ProfileName" type="LineEdit" parent="CanvasLayer/Center/VBox"]
custom_minimum_size = Vector2(0, 44)
placeholder_text = "Local profile name"
max_length = 48

[node name="ModeLabel" type="Label" parent="CanvasLayer/Center/VBox"]
text = "Game mode"

[node name="Mode" type="OptionButton" parent="CanvasLayer/Center/VBox"]
custom_minimum_size = Vector2(0, 44)

[node name="CharacterLabel" type="Label" parent="CanvasLayer/Center/VBox"]
text = "Character"

[node name="Character" type="OptionButton" parent="CanvasLayer/Center/VBox"]
custom_minimum_size = Vector2(0, 44)

[node name="Apply" type="Button" parent="CanvasLayer/Center/VBox"]
